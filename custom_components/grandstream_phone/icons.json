{
  "entity": {
    "binary_sensor": {
      "ringing": {
        "default": "mdi:phone-ring"
      },
      "in_use": {
        "default": "mdi:phone-in-talk"
      },
      "sip_registered": {
        "default": "mdi:phone-check",
        "state": {
          "off": "mdi:phone-remove"
        }
      },
      "on_charger": {
        "default": "mdi:power-plug",
        "state": {
          "off": "mdi:power-plug-off"
        }
      }
    },
    "event": {
      "call": {
        "default": "mdi:phone",
        "state_attributes": {
          "event_type": {
            "state": {
              "incoming": "mdi:phone-incoming",
              "answered": "mdi:phone-in-talk",
              "outgoing": "mdi:phone-outgoing",
              "missed": "mdi:phone-missed",
              "ended": "mdi:phone-hangup"
            }
          }
        }
      }
    },
    "number": {
      "lcd_brightness": {
        "default": "mdi:brightness-6"
      },
      "ring_volume": {
        "default": "mdi:volume-high"
      }
    },
    "select": {
      "backlight_timeout": {
        "default": "mdi:timer-outline"
      },
      "keypad_backlight": {
        "default": "mdi:dialpad"
      }
    },
    "sensor": {
      "call_state": {
        "default": "mdi:phone",
        "state": {
          "ringing": "mdi:phone-ring",
          "connected": "mdi:phone-in-talk",
          "on_hold": "mdi:phone-paused"
        }
      },
      "unread_voicemail": {
        "default": "mdi:voicemail"
      },
      "wifi_signal": {
        "default": "mdi:wifi"
      },
      "last_pushed_event": {
        "default": "mdi:webhook"
      }
    },
    "switch": {
      "do_not_disturb": {
        "default": "mdi:minus-circle",
        "state": {
          "off": "mdi:minus-circle-off"
        }
      },
      "wifi_power_save": {
        "default": "mdi:wifi-cog",
        "state": {
          "off": "mdi:wifi"
        }
      }
    }
  }
}
